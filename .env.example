# Copy to .env.local and fill in your own values.
# Never commit .env.local or any real key.

# Supabase (required) — from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# AI chat (optional — needed only for the owner AI chat at /chat)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
OPENROUTER_MODEL=
GEMINI_MODEL=
